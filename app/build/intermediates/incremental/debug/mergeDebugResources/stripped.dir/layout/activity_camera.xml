<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#1A1A2E">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@null"
            android:contentDescription="رجوع" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📷 كاميرا المسار الأمامي"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Switch
            android:id="@+id/switchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#FFFFFF"
            android:trackTint="#2D6AE8" />
    </LinearLayout>

    <!-- معاينة الكاميرا -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <android.view.SurfaceView
            android:id="@+id/surfaceCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- حالة -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="اضغط زر التقاط"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="#80000000"
            android:padding="16dp" />

        <!-- عداد -->
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:text="📷 0 صورة"
            android:textColor="#00C853"
            android:textSize="14sp"
            android:background="#80000000"
            android:padding="8dp" />
    </FrameLayout>

    <!-- أزرار التحكم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="#1A1A2E">

        <!-- زر التقاط -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="24dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="التقاط"
            app:backgroundTint="#2D6AE8"
            app:tint="#FFFFFF" />

        <!-- زر التقاط تلقائي -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutoCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ التقاط تلقائي"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#2D6AE8" />

        <!-- زر معرض الصور -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📂 المعرض"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#00C853" />
    </LinearLayout>
</LinearLayout>
